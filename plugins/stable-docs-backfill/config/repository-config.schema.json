{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/stable-docs-backfill/repository-config.schema.json",
  "title": "Stable Docs Backfill repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalDocs",
    "pendingPath",
    "compactionPath",
    "statePath",
    "implementationsPath",
    "dangerRules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "canonicalDocs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "owner"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/projectRelativePath"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "moduleInventory": {
            "type": "boolean"
          }
        }
      }
    },
    "pendingPath": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "compactionPath": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "statePath": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "implementationsPath": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "excludePaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectRelativePath"
      },
      "uniqueItems": true
    },
    "dangerRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "literals",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "literals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/projectRelativePath"
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}

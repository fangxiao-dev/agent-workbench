{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-harness-eval.v0.2.schema.json",
  "title": "Codex Harness Eval v0.2",
  "description": "Canonical behavioral eval cases for the thin Codex Crew control plane.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "codex-harness.eval.v0.2"},
    "skill_name": {"enum": ["codex-crew", "codex-crew-lite"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "assertion": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "externalMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "observed", "resources"],
      "properties": {
        "allowed": {"type": "boolean"},
        "observed": {"type": "boolean"},
        "resources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "owner_approval": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "skill_behaviors",
        "expected_output",
        "hard_invariants",
        "forbidden_actions",
        "advisory_quality",
        "evidence",
        "terminal_state",
        "external_mutation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "prompt": {"type": "string", "minLength": 1},
        "skill_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "expected_output": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "hard_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "advisory_quality": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "terminal_state": {
          "enum": ["succeeded", "awaiting_owner", "blocked", "attention", "cancelled", "failed"]
        },
        "external_mutation": {"$ref": "#/$defs/externalMutation"},
        "fixture_path": {
          "type": "string",
          "pattern": "^fixtures/[A-Za-z0-9_.-]+\\.json$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew-parent.v2.schema.json",
  "title": "Codex Crew Parent Protocol v2",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/route"},
    {"$ref": "#/$defs/status"},
    {"$ref": "#/$defs/state"}
  ],
  "$defs": {
    "mode": {"enum": ["lite", "full"]},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "status", "recommended_mode", "rationale", "required_inputs"],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-route.v0"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"const": "awaiting_mode_confirmation"},
        "recommended_mode": {"$ref": "#/$defs/mode"},
        "rationale": {"type": "string", "minLength": 1},
        "required_inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "status", "summary"],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-status.v0"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["running", "awaiting_owner", "awaiting_mode_confirmation", "completed", "failed"]},
        "summary": {"type": "string", "minLength": 1},
        "owner_request": {"type": "object"},
        "mode_request": {"type": "object"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "repository_root", "harness_root", "artifact_root", "issue", "parent", "parent_execution", "parent_context", "mode", "execution_topology", "serial_workspace", "status", "policy_identity", "decision_requests", "dispatch_refs", "last_message", "worktree_status_baseline", "events"],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-state.v2"},
        "run_id": {"type": "string", "minLength": 1},
        "repository_root": {"type": "string", "minLength": 1},
        "harness_root": {"type": "string", "minLength": 1},
        "artifact_root": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1},
        "parent": {"type": "object"},
        "parent_execution": {"type": ["object", "null"]},
        "parent_context": {"const": {"fresh": true, "scope": "work_package"}},
        "mode": {"type": "object"},
        "execution_topology": {"oneOf": [{"type": "null"}, {"$ref": "codex-crew-execution-topology.v0.schema.json"}]},
        "serial_workspace": {"type": ["object", "null"]},
        "status": {"enum": ["starting", "awaiting_mode_confirmation", "awaiting_execution_topology", "running", "awaiting_owner", "completed", "failed"]},
        "policy_identity": {"type": ["object", "null"]},
        "decision_requests": {"type": "array"},
        "dispatch_refs": {"type": "array"},
        "last_message": {"type": "string"},
        "worktree_status_baseline": {"type": "string"},
        "events": {"type": "array"}
      }
    }
  }
}

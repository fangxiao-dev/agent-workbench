{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew.verifier-result.v0.1.schema.json",
  "title": "Codex Crew Verifier Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "assignment_id", "revision", "base_commit", "head_commit", "worker_result_digest", "profile", "thread_id", "turn_id", "status", "independent", "recursive", "summary", "findings", "verification", "observed_at"],
  "properties": {
    "schema_version": {"const": "codex-crew.verifier-result.v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "head_commit": {"type": "string", "minLength": 1},
    "worker_result_digest": {"type": "string", "minLength": 1},
    "profile": {"const": "verifier-sol-high"},
    "thread_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "independent": {"const": true},
    "recursive": {"const": false},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object"}},
    "verification": {"type": "array", "items": {"type": "object"}},
    "observed_at": {"type": "number"}
  }
}

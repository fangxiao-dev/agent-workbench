{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew-parent.v1.schema.json",
  "title": "Codex Crew Parent Protocol v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/route"},
    {"$ref": "#/$defs/status"},
    {"$ref": "#/$defs/state"}
  ],
  "$defs": {
    "mode": {"enum": ["lite", "full"]},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "status", "recommended_mode", "rationale", "required_inputs"],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-route.v0"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"const": "awaiting_mode_confirmation"},
        "recommended_mode": {"$ref": "#/$defs/mode"},
        "rationale": {"type": "string", "minLength": 1},
        "required_inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "status", "summary"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "awaiting_owner"}}},
          "then": {"required": ["owner_request"]}
        },
        {
          "if": {"properties": {"status": {"const": "awaiting_mode_confirmation"}}},
          "then": {"required": ["mode_request"]}
        }
      ],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-status.v0"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["running", "awaiting_owner", "awaiting_mode_confirmation", "completed", "failed"]},
        "summary": {"type": "string", "minLength": 1},
        "owner_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "detail", "question"],
          "properties": {
            "category": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]},
            "detail": {"type": "string", "minLength": 1},
            "question": {"type": "string", "minLength": 1}
          }
        },
        "mode_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recommended_mode", "rationale"],
          "properties": {
            "recommended_mode": {"$ref": "#/$defs/mode"},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "repository_root", "harness_root", "artifact_root", "issue", "parent", "parent_execution", "mode", "status", "policy_identity", "decision_requests", "dispatch_refs", "last_message", "worktree_status_baseline", "events"],
      "properties": {
        "schema_version": {"const": "codex-crew.parent-state.v1"},
        "run_id": {"type": "string", "minLength": 1},
        "repository_root": {"type": "string", "minLength": 1},
        "harness_root": {"type": "string", "minLength": 1},
        "artifact_root": {"type": "string", "minLength": 1},
        "state_path": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1},
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_id", "profile_path", "sandbox", "approval_policy"],
          "properties": {
            "thread_id": {"type": ["string", "null"]},
            "profile_path": {"type": "string", "minLength": 1},
            "sandbox": {"enum": ["read-only", "workspace-write"]},
            "approval_policy": {"type": "string", "minLength": 1}
          }
        },
        "parent_execution": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["profile", "model", "reasoning_effort", "identity"],
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "reasoning_effort": {"type": "string", "minLength": 1},
            "identity": {"type": "object"}
          }
        },
        "mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "proposed", "confirmed", "rationale"],
          "properties": {
            "status": {"enum": ["routing", "awaiting_confirmation", "confirmed"]},
            "proposed": {"type": ["string", "null"], "enum": ["lite", "full", null]},
            "confirmed": {"type": ["string", "null"], "enum": ["lite", "full", null]},
            "rationale": {"type": "string"}
          }
        },
        "status": {"enum": ["starting", "awaiting_mode_confirmation", "running", "awaiting_owner", "completed", "failed"]},
        "policy_identity": {"type": ["object", "null"]},
        "decision_requests": {"type": "array"},
        "dispatch_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "profile", "status"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "profile": {"$ref": "#/$defs/mode"},
              "status": {"enum": ["running", "attention", "completed", "failed"]}
            }
          }
        },
        "last_message": {"type": "string"},
        "worktree_status_baseline": {"type": "string"},
        "events": {"type": "array"}
      }
    }
  }
}

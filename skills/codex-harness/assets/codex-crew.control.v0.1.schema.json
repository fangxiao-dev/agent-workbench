{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-crew.control.v0.1",
  "title": "Codex Crew thin control plane v0.1",
  "description": "Canonical run snapshot and narrow Orchestrator/Worker envelopes for the thin Codex Crew control plane. Requested execution values are controller requests, not provider-confirmed actual model evidence.",
  "type": "object",
  "required": ["schema_version", "run_id", "repository_root", "artifact_root", "state_path", "issue", "status", "action_count", "max_actions", "policy_identity", "orchestrator", "execution", "assignments", "owner_requests", "messages", "acceptances", "events", "last_message", "quarantine", "controller"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "codex-crew.control.v0.1"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "repository_root": {"type": "string", "minLength": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "state_path": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "awaiting_owner", "verifying", "blocked", "succeeded", "failed", "cancelling", "cancelled"]},
    "action_count": {"type": "integer", "minimum": 0},
    "max_actions": {"type": "integer", "minimum": 1},
    "policy_identity": {"type": "object", "required": ["schema_version", "policy_path", "schema_path", "policy_sha256", "schema_sha256", "maturity"], "properties": {"schema_version": {"const": "codex-harness.runtime-policy.v1"}, "policy_path": {"type": "string"}, "schema_path": {"type": "string"}, "policy_sha256": {"type": "string"}, "schema_sha256": {"type": "string"}, "maturity": {"enum": ["design_baseline", "runtime_enforced"]}}},
    "orchestrator": {"$ref": "#/$defs/orchestrator"},
    "execution": {"$ref": "#/$defs/execution"},
    "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "owner_requests": {"type": "array", "items": {"$ref": "#/$defs/ownerRequest"}},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "acceptances": {"type": "array", "items": {"$ref": "#/$defs/acceptance"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "last_message": {"type": "string"},
    "quarantine": {"type": ["object", "null"]},
    "controller": {"$ref": "#/$defs/controller"}
  },
  "$defs": {
    "runSnapshot": {
      "type": "object",
      "description": "The root object is the canonical run snapshot; this named definition exists for callers that validate an envelope by reference.",
      "required": ["schema_version", "run_id", "status", "assignments", "execution", "orchestrator"],
      "properties": {
        "schema_version": {"const": "codex-crew.control.v0.1"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "assignments": {"type": "array"},
        "execution": {"$ref": "#/$defs/execution"},
        "orchestrator": {"$ref": "#/$defs/orchestrator"}
      }
    },
    "orchestratorTurn": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "run_id", "action", "summary"],
      "properties": {
        "schema_version": {"const": "codex-crew.orchestrator-turn.v0"},
        "run_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["dispatch", "control", "ask_owner", "finish"]},
        "summary": {"type": "string"},
        "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
        "operation": {"enum": ["continue", "accept", "cancel"]},
        "assignment_id": {"type": "string"},
        "owner_request": {"$ref": "#/$defs/ownerRequest"}
      }
    },
    "workerResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "assignment_id", "revision", "status", "summary", "verification", "changed_paths"],
      "properties": {
        "schema_version": {"const": "codex-crew.worker-result.v0"},
        "assignment_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["succeeded", "needs_orchestrator", "needs_owner", "failed"]},
        "summary": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "artifacts": {"type": "array"},
        "verification": {"type": "array", "items": {"type": "object"}},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "owner_request": {"type": ["object", "null"]},
        "subagent_telemetry": {"type": "object"}
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "sandbox", "approval_policy", "context_fresh", "requested_execution", "turn", "boundary_evidence"],
      "properties": {
        "thread_id": {"type": ["string", "null"]},
        "sandbox": {"const": "read-only"},
        "approval_policy": {"const": "never"},
        "context_fresh": {"const": true},
        "requested_execution": {"$ref": "#/$defs/requestedExecution"},
        "turn": {"$ref": "#/$defs/turnEvidence"},
        "boundary_evidence": {"$ref": "#/$defs/boundaryEvidence"}
      }
    },
    "requestedExecution": {
      "type": "object",
      "description": "Controller-requested execution parameters. model and reasoning_effort are not provider-confirmed actual values.",
      "additionalProperties": false,
      "required": ["profile", "model", "reasoning_effort", "sandbox", "approval_policy", "network_access"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "reasoning_effort": {"type": ["string", "null"]},
        "sandbox": {"const": "read-only"},
        "approval_policy": {"const": "never"},
        "network_access": {"const": false}
      }
    },
    "turnEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "started_at", "phase", "completion", "terminal", "interrupt", "notification_summary"],
      "properties": {
        "turn_id": {"type": ["string", "null"]},
        "started_at": {"type": ["number", "null"]},
        "phase": {"enum": ["not_started", "started", "collecting_completion", "reconciling_history", "interrupt_requested", "interrupt_confirmed", "terminal_observed", "completion_unknown"]},
        "completion": {"$ref": "#/$defs/completionObservation"},
        "terminal": {"$ref": "#/$defs/terminalObservation"},
        "interrupt": {"$ref": "#/$defs/interruptEvidence"},
        "notification_summary": {"$ref": "#/$defs/notificationSummary"}
      }
    },
    "completionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "observed_at", "valid_envelope"],
      "properties": {
        "status": {"enum": ["not_started", "awaiting_terminal", "completed", "timed_out", "unknown_timeout"]},
        "source": {"enum": ["none", "turn_start_notifications", "notification_collection", "thread_history", "post_interrupt_reconciliation"]},
        "observed_at": {"type": ["number", "null"]},
        "valid_envelope": {"type": "boolean"}
      }
    },
    "terminalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "status", "source", "observed_at", "valid_envelope"],
      "properties": {
        "observed": {"type": "boolean"},
        "status": {"enum": ["not_observed", "completed", "failed", "interrupted", "cancelled"]},
        "source": {"enum": ["none", "turn_start_notifications", "notification_collection", "thread_history", "post_interrupt_reconciliation"]},
        "observed_at": {"type": ["number", "null"]},
        "valid_envelope": {"type": "boolean"}
      }
    },
    "interruptEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "acknowledged", "requested_at", "acknowledged_at", "error"],
      "properties": {
        "attempted": {"type": "boolean"},
        "acknowledged": {"type": "boolean"},
        "requested_at": {"type": ["number", "null"]},
        "acknowledged_at": {"type": ["number", "null"]},
        "error": {"type": ["string", "null"]}
      }
    },
    "notificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_count", "methods"],
      "properties": {
        "observed_count": {"type": "integer", "minimum": 0},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/notificationMethod"}}
      }
    },
    "notificationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "count"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "boundaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_git", "post_git"],
      "properties": {
        "pre_git": {"$ref": "#/$defs/gitBoundary"},
        "post_git": {"$ref": "#/$defs/gitBoundary"}
      }
    },
    "gitBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "availability", "is_clean", "porcelain", "error"],
      "properties": {
        "observed_at": {"type": ["number", "null"]},
        "availability": {"enum": ["observed", "unavailable"]},
        "is_clean": {"type": ["boolean", "null"]},
        "porcelain": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "max_active_write_worktrees", "workspace_reuse_policy", "parallelism_rationale"],
      "properties": {
        "topology": {"enum": ["orchestrator_read_only", "worker_serial", "worker_parallel"]},
        "max_active_write_worktrees": {"type": "integer", "minimum": 0},
        "workspace_reuse_policy": {"type": "string", "minLength": 1},
        "parallelism_rationale": {"type": ["string", "null"]}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "assignment_id", "kind", "revision", "goal", "non_goals", "assurance_mode", "execution_profile", "allowed_paths", "external_resources", "verification_commands", "depends_on", "context", "status", "workspace", "worker", "result", "acceptance"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["delivery", "verification"]},
        "revision": {"type": "integer", "minimum": 1},
        "goal": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "assurance_mode": {"enum": ["lite", "full"]},
        "execution_profile": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "external_resources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "context": {"$ref": "#/$defs/context"},
        "status": {"enum": ["planned", "ready", "running", "awaiting_orchestrator", "awaiting_owner", "submitted", "verifying", "accepted", "rejected", "failed", "cancelled"]},
        "workspace": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workspace"}]},
        "worker": {"$ref": "#/$defs/workerBinding"},
        "result": {"type": ["object", "null"]},
        "acceptance": {"type": ["object", "null"]}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "continuation_allowed"],
      "properties": {"fresh": {"type": "boolean"}, "continuation_allowed": {"type": "boolean"}}
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "base_ref"],
      "properties": {"path": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "base_ref": {"type": "string", "minLength": 1}, "handoff": {"type": "object"}}
    },
    "workerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "status"],
      "properties": {"thread_id": {"type": ["string", "null"]}, "status": {"enum": ["pending", "running", "stopped"]}}
    },
    "ownerRequest": {
      "type": "object",
      "required": ["category", "detail"],
      "properties": {"request_id": {"type": "string"}, "assignment_id": {"type": "string"}, "category": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]}, "detail": {"type": "string", "minLength": 1}}
    },
    "message": {
      "type": "object",
      "required": ["message_id", "kind", "provenance", "body", "at"],
      "properties": {"message_id": {"type": "string"}, "kind": {"enum": ["ordinary_correction", "owner_decision", "cancel_request"]}, "provenance": {"type": "string"}, "body": {"type": "string"}, "at": {"type": "number"}}
    },
    "acceptance": {
      "type": "object",
      "required": ["schema_version", "assignment_id", "revision", "worker_result_digest", "disposition", "accepted_at"],
      "properties": {
        "schema_version": {"const": "codex-crew.acceptance.v0"},
        "assignment_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "worker_result_digest": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "object"}},
        "verifier": {"type": ["object", "null"]},
        "disposition": {"enum": ["accepted", "rejected"]},
        "accepted_at": {"type": "number"}
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_path"],
      "properties": {"lock_path": {"type": "string", "minLength": 1}}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew-dispatch.v2.schema.json",
  "title": "Codex Crew Dispatch v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "execution_topology", "profile", "worker_profile", "repository_root", "parent_run_id", "parent_thread_id", "max_active_write_worktrees", "parallelism_rationale", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "codex-crew.dispatch.v2"},
    "execution_topology": {"const": "worker_parallel"},
    "profile": {"enum": ["lite", "full"]},
    "worker_profile": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": "string", "minLength": 1},
    "parent_thread_id": {"type": "string", "minLength": 1},
    "max_active_write_worktrees": {"type": "integer", "minimum": 2},
    "parallelism_rationale": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 2}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-harness-runtime-policy.v1.3.schema.json",
  "title": "Codex Harness Runtime Policy v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "maturity", "roles", "assignment", "workspace", "crew_control", "observation", "validation", "cancellation", "actions"],
  "properties": {
    "$schema": {"const": "./codex-harness-runtime-policy.v1.3.schema.json"},
    "schema_version": {"const": "codex-harness.runtime-policy.v1.3"},
    "maturity": {"enum": ["design_baseline", "runtime_enforced"]},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "orchestrator", "worker", "verifier"],
      "properties": {
        "broker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["business_channel", "global_observation", "canonical_planning", "worker_control", "break_glass"],
          "properties": {
            "business_channel": {"const": "orchestrator_only"},
            "global_observation": {"const": true},
            "canonical_planning": {"const": "forbidden"},
            "worker_control": {"const": "forbidden"},
            "break_glass": {"const": "thread_administration_only"}
          }
        },
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace", "owns", "subagent_control"],
          "properties": {
            "workspace": {"const": "read_only"},
            "owns": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"enum": ["assignment_definition", "worker_invocation", "worker_control", "workspace_decision", "verifier_invocation", "acceptance", "crew_intent", "material_notification"]}
            },
            "subagent_control": {"const": "forbidden"}
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_modes", "delivery_boundary", "subagent_control"],
          "properties": {
            "access_modes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["repository_read_only", "workspace_write"]}},
            "delivery_boundary": {"const": "cohesive_assignment"},
            "subagent_control": {"const": "worker_owned"}
          }
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace", "independence", "canonical_state_write"],
          "properties": {
            "workspace": {"const": "read_only"},
            "independence": {"const": "fresh_non_recursive"},
            "canonical_state_write": {"const": "forbidden"}
          }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "cohesion", "revision_policy", "owner_boundaries", "assignment_statuses"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"enum": ["run_id", "assignment_id", "revision", "goal", "non_goals", "assurance_mode", "execution_profile", "access_mode", "allowed_paths", "acceptance_criteria", "workspace"]}
        },
        "cohesion": {"const": "package_implementation_review_and_internal_steps_stay_together_unless_boundary_changes"},
        "revision_policy": {"const": "inactive_unaccepted_increment_by_one"},
        "owner_boundaries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]}
        },
        "assignment_statuses": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"enum": ["planned", "ready", "running", "awaiting_orchestrator", "awaiting_owner", "submitted", "verifying", "accepted", "rejected", "failed", "cancelled"]}
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_owner", "allowed_strategies", "new_path_scope", "new_branch_prefix", "worker_git_writable_roots", "common_git_dir_write", "reuse_scope", "reuse_requires", "materialization_trigger", "read_only_binding"],
      "properties": {
        "decision_owner": {"const": "orchestrator"},
        "allowed_strategies": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["new", "reuse"]}},
        "new_path_scope": {"const": "run_owned_workspace_root"},
        "new_branch_prefix": {"const": "codex/crew/<run-id>/<assignment-id>/"},
        "worker_git_writable_roots": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["linked_worktree_git_dir", "object_database", "assignment_branch_ref_dir", "assignment_branch_log_dir"]}},
        "common_git_dir_write": {"const": "forbidden"},
        "reuse_scope": {"const": "same_run_accepted_assignment"},
        "reuse_requires": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["accepted_handoff", "reported_commit", "clean_tree", "ancestor_continuity", "verification_evidence"]}},
        "materialization_trigger": {"const": "explicit_start_workers_only"},
        "read_only_binding": {"const": "repository_head_and_porcelain_before_after"}
      }
    },
    "crew_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_invocation", "worker_start_unit", "max_active_workers", "cohort_preflight", "automatic_ready_dispatch", "automatic_verifier_start", "automatic_run_finish", "parallel_requires", "downstream_prebuild"],
      "properties": {
        "capability_invocation": {"const": "orchestrator_explicit_only"},
        "worker_start_unit": {"const": "explicit_assignment_cohort"},
        "max_active_workers": {"const": 4},
        "cohort_preflight": {"const": "atomic_before_workspace_materialization"},
        "automatic_ready_dispatch": {"const": "forbidden"},
        "automatic_verifier_start": {"const": "forbidden"},
        "automatic_run_finish": {"const": "forbidden"},
        "parallel_requires": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["runtime_parallel_capability", "eligible_assignments", "satisfied_dependencies", "resolved_owner_gates", "available_profiles", "disjoint_write_ownership", "disjoint_external_resources"]}
        },
        "downstream_prebuild": {"const": "forbidden"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_panorama", "broker_access", "intent_owner", "observed_state_source", "material_notifications", "notification_approval_semantics"],
      "properties": {
        "canonical_panorama": {"const": "controller_snapshot"},
        "broker_access": {"const": "read_only_status"},
        "intent_owner": {"const": "orchestrator"},
        "observed_state_source": {"const": "controller_derived"},
        "material_notifications": {"const": "orchestrator_to_broker"},
        "notification_approval_semantics": {"const": "informational_only"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_required", "clean_tree_required", "path_boundary_required", "verification_commands_required", "full_independent_verifier", "verifier_invocation", "verifier_result_source", "natural_language_only", "read_only_changed_paths"],
      "properties": {
        "commit_required": {"const": true},
        "clean_tree_required": {"const": true},
        "path_boundary_required": {"const": true},
        "verification_commands_required": {"const": true},
        "full_independent_verifier": {"const": true},
        "verifier_invocation": {"const": "orchestrator_explicit"},
        "verifier_result_source": {"const": "controller_owned"},
        "natural_language_only": {"const": false},
        "read_only_changed_paths": {"const": "must_be_empty"}
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "request_transport", "interrupt_required", "terminal_evidence_required", "uncertain_disposition", "quarantine_reuse"],
      "properties": {
        "trigger": {"const": "explicit_cancel_request_only"},
        "request_transport": {"const": "atomic_sidecar"},
        "interrupt_required": {"const": true},
        "terminal_evidence_required": {"const": true},
        "uncertain_disposition": {"const": "blocked_quarantine"},
        "quarantine_reuse": {"const": "forbidden"}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "control_operations"],
      "properties": {
        "allowed": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["dispatch", "control", "ask_owner", "finish"]}},
        "control_operations": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["start_workers", "continue_worker", "run_verifier", "accept", "cancel_assignment"]}}
      }
    }
  }
}

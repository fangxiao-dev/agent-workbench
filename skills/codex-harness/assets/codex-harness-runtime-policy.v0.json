{
  "$schema": "./codex-harness-runtime-policy.schema.json",
  "schema_version": "codex-harness.runtime-policy.v0",
  "maturity": "design_baseline",
  "context": {
    "cross_task_start": "fresh_thread",
    "same_task_continuation": [
      "same_thread_new_turn",
      "resume",
      "fork",
      "fresh_thread"
    ],
    "thread_single_writer": true,
    "continuity_evidence_required": true
  },
  "delegation": {
    "mode": "bounded_autonomy",
    "parent_owns_execution_method": true,
    "per_child_approval": "not_required_within_boundaries",
    "authority_expansion": "owner_decision",
    "topology_is_acceptance_gate": false
  },
  "task_partitioning": {
    "responsibility_partition": "disjoint_by_default",
    "overlap_coordination": "explicit",
    "write_workspace_isolation": "per_task_worktree",
    "physical_conflict_claim": "not_guaranteed",
    "external_side_effects": "explicit_boundary"
  },
  "decision_routing": {
    "harness_resolvable": "continue_same_task",
    "owner_required": [
      "scope_change",
      "authority_expansion",
      "irreversible_external_side_effect",
      "acceptance_ambiguity"
    ]
  },
  "validation": {
    "parent_result": "structured",
    "external_verification": "required",
    "natural_language_only_is_sufficient": false
  },
  "lifecycle": {
    "thread_lease": "required_for_continuation",
    "run_resource_ledger": "required",
    "promotion": "manifest_policy",
    "cleanup": "after_terminal_disposition",
    "orphan_reconciliation": true
  },
  "boundary_failures": {
    "automatic_privilege_escalation": false,
    "capability_blocked": "needs_decision",
    "boundary_rejected": "non_retryable"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-harness-execution-profiles.v0.schema.json",
  "title": "Codex Harness Execution Profiles v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profiles", "worker_bindings"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "codex-harness.execution-profiles.v0"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "model", "reasoning_effort"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["parent", "worker"]},
          "model": {"type": "string", "minLength": 1},
          "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}
        }
      }
    },
    "worker_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lite", "full"],
      "properties": {
        "lite": {"type": "string", "minLength": 1},
        "full": {"type": "string", "minLength": 1}
      }
    }
  }
}

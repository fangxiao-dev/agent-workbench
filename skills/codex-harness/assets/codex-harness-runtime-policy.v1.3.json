{
  "$schema": "./codex-harness-runtime-policy.v1.3.schema.json",
  "schema_version": "codex-harness.runtime-policy.v1.3",
  "maturity": "design_baseline",
  "roles": {
    "broker": {
      "business_channel": "orchestrator_only",
      "global_observation": true,
      "canonical_planning": "forbidden",
      "worker_control": "forbidden",
      "break_glass": "thread_administration_only"
    },
    "orchestrator": {
      "workspace": "read_only",
      "owns": [
        "assignment_definition",
        "worker_invocation",
        "worker_control",
        "workspace_decision",
        "verifier_invocation",
        "acceptance",
        "crew_intent",
        "material_notification"
      ],
      "subagent_control": "forbidden"
    },
    "worker": {
      "access_modes": ["repository_read_only", "workspace_write"],
      "delivery_boundary": "cohesive_assignment",
      "subagent_control": "worker_owned"
    },
    "verifier": {
      "workspace": "read_only",
      "independence": "fresh_non_recursive",
      "canonical_state_write": "forbidden"
    }
  },
  "assignment": {
    "required": [
      "run_id",
      "assignment_id",
      "revision",
      "goal",
      "non_goals",
      "assurance_mode",
      "execution_profile",
      "access_mode",
      "allowed_paths",
      "acceptance_criteria",
      "workspace"
    ],
    "cohesion": "package_implementation_review_and_internal_steps_stay_together_unless_boundary_changes",
    "revision_policy": "inactive_unaccepted_increment_by_one",
    "owner_boundaries": [
      "scope_change",
      "authority_expansion",
      "irreversible_external_side_effect",
      "acceptance_ambiguity"
    ],
    "assignment_statuses": [
      "planned",
      "ready",
      "running",
      "awaiting_orchestrator",
      "awaiting_owner",
      "submitted",
      "verifying",
      "accepted",
      "rejected",
      "failed",
      "cancelled"
    ]
  },
  "workspace": {
    "decision_owner": "orchestrator",
    "allowed_strategies": ["new", "reuse"],
    "new_path_scope": "run_owned_workspace_root",
    "new_branch_prefix": "codex/crew/<run-id>/<assignment-id>/",
    "worker_git_writable_roots": [
      "linked_worktree_git_dir",
      "object_database",
      "assignment_branch_ref_dir",
      "assignment_branch_log_dir"
    ],
    "common_git_dir_write": "forbidden",
    "reuse_scope": "same_run_accepted_assignment",
    "reuse_requires": [
      "accepted_handoff",
      "reported_commit",
      "clean_tree",
      "ancestor_continuity",
      "verification_evidence"
    ],
    "materialization_trigger": "explicit_start_workers_only",
    "read_only_binding": "repository_head_and_porcelain_before_after"
  },
  "crew_control": {
    "capability_invocation": "orchestrator_explicit_only",
    "worker_start_unit": "explicit_assignment_cohort",
    "max_active_workers": 4,
    "cohort_preflight": "atomic_before_workspace_materialization",
    "automatic_ready_dispatch": "forbidden",
    "automatic_verifier_start": "forbidden",
    "automatic_run_finish": "forbidden",
    "parallel_requires": [
      "runtime_parallel_capability",
      "eligible_assignments",
      "satisfied_dependencies",
      "resolved_owner_gates",
      "available_profiles",
      "disjoint_write_ownership",
      "disjoint_external_resources"
    ],
    "downstream_prebuild": "forbidden"
  },
  "observation": {
    "canonical_panorama": "controller_snapshot",
    "broker_access": "read_only_status",
    "intent_owner": "orchestrator",
    "observed_state_source": "controller_derived",
    "material_notifications": "orchestrator_to_broker",
    "notification_approval_semantics": "informational_only"
  },
  "validation": {
    "commit_required": true,
    "clean_tree_required": true,
    "path_boundary_required": true,
    "verification_commands_required": true,
    "full_independent_verifier": true,
    "verifier_invocation": "orchestrator_explicit",
    "verifier_result_source": "controller_owned",
    "natural_language_only": false,
    "read_only_changed_paths": "must_be_empty"
  },
  "cancellation": {
    "trigger": "explicit_cancel_request_only",
    "request_transport": "atomic_sidecar",
    "interrupt_required": true,
    "terminal_evidence_required": true,
    "uncertain_disposition": "blocked_quarantine",
    "quarantine_reuse": "forbidden"
  },
  "actions": {
    "allowed": ["dispatch", "control", "ask_owner", "finish"],
    "control_operations": ["start_workers", "continue_worker", "run_verifier", "accept", "cancel_assignment"]
  }
}

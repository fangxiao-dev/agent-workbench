{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew.orchestrator-turn.v0.3.schema.json",
  "title": "Codex Crew Orchestrator Turn v0.3",
  "oneOf": [
    {"$ref": "#/$defs/dispatchTurn"},
    {"$ref": "#/$defs/controlTurn"},
    {"$ref": "#/$defs/askOwnerTurn"},
    {"$ref": "#/$defs/finishTurn"}
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "crewIntentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "rationale"],
      "properties": {
        "shape": {"enum": ["orchestrator_read_only", "single_writer", "multi_writer"]},
        "rationale": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "brokerNotificationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "assignment_ids"],
      "properties": {
        "kind": {"enum": ["crew_intent_changed", "material_plan_change", "workspace_decision_changed", "delivery_risk", "owner_attention"]},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "workspaceIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "handoff_from", "path", "branch", "base_ref"],
      "properties": {
        "strategy": {"enum": ["new", "reuse"]},
        "handoff_from": {"type": ["string", "null"]},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/nonEmptyString"},
        "base_ref": {"$ref": "#/$defs/nonEmptyString"}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "new"}}, "required": ["strategy"]},
          "then": {"properties": {"handoff_from": {"type": "null"}}}
        },
        {
          "if": {"properties": {"strategy": {"const": "reuse"}}, "required": ["strategy"]},
          "then": {"properties": {"handoff_from": {"$ref": "#/$defs/identifier"}}}
        }
      ]
    },
    "assignmentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "kind", "revision", "goal", "non_goals", "acceptance_criteria", "assurance_mode", "execution_profile", "access_mode", "allowed_paths", "external_resources", "verification_commands", "depends_on", "context", "workspace"],
      "properties": {
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "kind": {"const": "delivery"},
        "revision": {"type": "integer", "minimum": 1},
        "goal": {"$ref": "#/$defs/nonEmptyString"},
        "non_goals": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "assurance_mode": {"enum": ["lite", "full"]},
        "execution_profile": {"$ref": "#/$defs/nonEmptyString"},
        "access_mode": {"enum": ["repository_read_only", "workspace_write"]},
        "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "external_resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "verification_commands": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fresh", "continuation_allowed"],
          "properties": {"fresh": {"type": "boolean"}, "continuation_allowed": {"type": "boolean"}}
        },
        "workspace": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workspaceIntent"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"access_mode": {"const": "repository_read_only"}}, "required": ["access_mode"]},
          "then": {"properties": {"allowed_paths": {"type": "array", "maxItems": 0}, "workspace": {"type": "null"}}},
          "else": {"properties": {"allowed_paths": {"type": "array", "minItems": 1}, "workspace": {"$ref": "#/$defs/workspaceIntent"}}}
        }
      ]
    },
    "dispatchTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "action", "summary", "assignments"],
      "properties": {
        "schema_version": {"const": "codex-crew.orchestrator-turn.v0.3"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "dispatch"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignmentDefinition"}},
        "crew_intent": {"$ref": "#/$defs/crewIntentInput"},
        "broker_notifications": {"type": "array", "items": {"$ref": "#/$defs/brokerNotificationInput"}}
      }
    },
    "controlTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "action", "summary", "operation"],
      "properties": {
        "schema_version": {"const": "codex-crew.orchestrator-turn.v0.3"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "control"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "operation": {"enum": ["start_workers", "continue_worker", "run_verifier", "accept", "cancel_assignment"]},
        "assignment_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "crew_intent": {"$ref": "#/$defs/crewIntentInput"},
        "broker_notifications": {"type": "array", "items": {"$ref": "#/$defs/brokerNotificationInput"}}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "start_workers"}}, "required": ["operation"]},
          "then": {"required": ["assignment_ids"], "not": {"anyOf": [{"required": ["assignment_id"]}, {"required": ["message"]}, {"required": ["reason"]}]}}
        },
        {
          "if": {"properties": {"operation": {"const": "continue_worker"}}, "required": ["operation"]},
          "then": {"required": ["assignment_id", "message"], "not": {"anyOf": [{"required": ["assignment_ids"]}, {"required": ["reason"]}]}}
        },
        {
          "if": {"properties": {"operation": {"enum": ["run_verifier", "accept"]}}, "required": ["operation"]},
          "then": {"required": ["assignment_id"], "not": {"anyOf": [{"required": ["assignment_ids"]}, {"required": ["message"]}, {"required": ["reason"]}]}}
        },
        {
          "if": {"properties": {"operation": {"const": "cancel_assignment"}}, "required": ["operation"]},
          "then": {"required": ["assignment_id", "reason"], "not": {"anyOf": [{"required": ["assignment_ids"]}, {"required": ["message"]}]}}
        }
      ]
    },
    "askOwnerTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "action", "summary", "request"],
      "properties": {
        "schema_version": {"const": "codex-crew.orchestrator-turn.v0.3"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "ask_owner"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "request": {"$ref": "#/$defs/ownerRequestInput"},
        "crew_intent": {"$ref": "#/$defs/crewIntentInput"},
        "broker_notifications": {"type": "array", "items": {"$ref": "#/$defs/brokerNotificationInput"}}
      }
    },
    "ownerRequestInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "assignment_id", "category", "detail"],
      "properties": {
        "scope": {"enum": ["assignment", "run"]},
        "assignment_id": {"type": ["string", "null"]},
        "category": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]},
        "detail": {"$ref": "#/$defs/nonEmptyString"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "assignment"}}, "required": ["scope"]},
          "then": {"properties": {"assignment_id": {"$ref": "#/$defs/identifier"}}},
          "else": {"properties": {"assignment_id": {"type": "null"}}}
        }
      ]
    },
    "finishTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "action", "summary", "disposition", "fact_refs", "incomplete_facts"],
      "properties": {
        "schema_version": {"const": "codex-crew.orchestrator-turn.v0.3"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "action": {"const": "finish"},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "disposition": {"enum": ["succeeded", "partial", "blocked", "needs_owner", "failed"]},
        "fact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "incomplete_facts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "crew_intent": {"$ref": "#/$defs/crewIntentInput"},
        "broker_notifications": {"type": "array", "items": {"$ref": "#/$defs/brokerNotificationInput"}}
      }
    }
  }
}

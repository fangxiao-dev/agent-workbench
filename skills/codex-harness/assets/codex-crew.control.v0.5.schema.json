{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/codex-crew.control.v0.5.schema.json",
  "title": "Codex Crew Control Snapshot v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "run_id", "repository_root", "artifact_root", "workspace_root", "state_path", "issue", "status", "policy_identity", "orchestrator", "crew", "assignments", "owner_requests", "messages", "broker_notifications", "acceptances", "events", "last_message", "terminal", "quarantine", "cancellation", "controller"],
  "properties": {
    "$schema": {"const": "./codex-crew.control.v0.5.schema.json"},
    "schema_version": {"const": "codex-crew.control.v0.5"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "repository_root": {"$ref": "#/$defs/nonEmptyString"},
    "artifact_root": {"$ref": "#/$defs/nonEmptyString"},
    "workspace_root": {"$ref": "#/$defs/nonEmptyString"},
    "state_path": {"$ref": "#/$defs/nonEmptyString"},
    "issue": {"$ref": "#/$defs/nonEmptyString"},
    "status": {"enum": ["running", "awaiting_owner", "blocked", "cancelling", "cancelled", "finished"]},
    "policy_identity": {"$ref": "#/$defs/policyIdentity"},
    "orchestrator": {"$ref": "#/$defs/orchestrator"},
    "crew": {"$ref": "#/$defs/crew"},
    "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
    "owner_requests": {"type": "array", "items": {"$ref": "#/$defs/ownerRequest"}},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "broker_notifications": {"type": "array", "items": {"$ref": "#/$defs/brokerNotification"}},
    "acceptances": {"type": "array", "items": {"$ref": "#/$defs/acceptance"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "last_message": {"type": "string"},
    "terminal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/runTerminal"}]},
    "quarantine": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/quarantine"}]},
    "cancellation": {"$ref": "#/$defs/cancellation"},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_path"],
      "properties": {"lock_path": {"$ref": "#/$defs/nonEmptyString"}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "finished"}}, "required": ["status"]},
      "then": {"properties": {"terminal": {"$ref": "#/$defs/runTerminal"}}},
      "else": {"properties": {"terminal": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"]},
    "timestamp": {"type": "number"},
    "nullableTimestamp": {"type": ["number", "null"]},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_path", "schema_path", "policy_sha256", "schema_sha256", "maturity"],
      "properties": {
        "schema_version": {"const": "codex-harness.runtime-policy.v1.3"},
        "policy_path": {"$ref": "#/$defs/nonEmptyString"},
        "schema_path": {"$ref": "#/$defs/nonEmptyString"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "maturity": {"enum": ["design_baseline", "runtime_enforced"]}
      }
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "model", "reasoning_effort"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"const": "worker"},
        "model": {"$ref": "#/$defs/nonEmptyString"},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}
      }
    },
    "executionProfileSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_candidates", "selected_profile", "catalog_digest", "observed_at", "reason"],
      "properties": {
        "requested_candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executionProfile"}},
        "selected_profile": {"$ref": "#/$defs/executionProfile"},
        "catalog_digest": {"$ref": "#/$defs/sha256"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "reason": {"enum": ["first_available_candidate", "fallback_after_unavailable_prior_candidates"]}
      }
    },
    "workspaceLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "acquired_at", "released_at"],
      "properties": {
        "status": {"enum": ["inactive", "active", "released"]},
        "acquired_at": {"$ref": "#/$defs/nullableTimestamp"},
        "released_at": {"$ref": "#/$defs/nullableTimestamp"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "handoff_from", "path", "branch", "base_ref", "materialized", "lease"],
      "properties": {
        "strategy": {"enum": ["new", "reuse"]},
        "handoff_from": {"type": ["string", "null"]},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/nonEmptyString"},
        "base_ref": {"$ref": "#/$defs/nonEmptyString"},
        "materialized": {"type": "boolean"},
        "lease": {"$ref": "#/$defs/workspaceLease"}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "new"}}, "required": ["strategy"]},
          "then": {"properties": {"handoff_from": {"type": "null"}}}
        },
        {
          "if": {"properties": {"strategy": {"const": "reuse"}}, "required": ["strategy"]},
          "then": {"properties": {"handoff_from": {"$ref": "#/$defs/identifier"}}}
        }
      ]
    },
    "interrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "acknowledged", "requested_at", "acknowledged_at", "error"],
      "properties": {
        "attempted": {"type": "boolean"},
        "acknowledged": {"type": "boolean"},
        "requested_at": {"$ref": "#/$defs/nullableTimestamp"},
        "acknowledged_at": {"$ref": "#/$defs/nullableTimestamp"},
        "error": {"$ref": "#/$defs/nullableString"}
      }
    },
    "workerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "turn_id", "status", "interrupt"],
      "properties": {
        "thread_id": {"$ref": "#/$defs/nullableString"},
        "turn_id": {"$ref": "#/$defs/nullableString"},
        "status": {"enum": ["pending", "running", "stopped"]},
        "interrupt": {"$ref": "#/$defs/interrupt"}
      }
    },
    "verificationEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command", "exit_code"],
      "properties": {
        "command": {"$ref": "#/$defs/nonEmptyString"},
        "exit_code": {"type": "integer"},
        "claim": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "workerOwnerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "detail"],
      "properties": {
        "category": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]},
        "detail": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "workerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "assignment_id", "revision", "status", "summary", "commit", "changed_paths", "artifacts", "verification", "owner_request", "subagent_telemetry", "worker_thread_id", "worker_turn_id"],
      "properties": {
        "schema_version": {"const": "codex-crew.worker-result.v0.1"},
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["succeeded", "needs_orchestrator", "needs_owner", "failed"]},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "commit": {"type": ["string", "null"]},
        "changed_paths": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "artifacts": {"type": "array"},
        "verification": {"type": "array", "items": {"$ref": "#/$defs/verificationEvidence"}},
        "owner_request": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workerOwnerRequest"}]},
        "subagent_telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delegated", "active_count"],
          "properties": {"delegated": {"type": "boolean"}, "active_count": {"type": "integer", "minimum": 0}}
        },
        "worker_thread_id": {"$ref": "#/$defs/nullableString"},
        "worker_turn_id": {"$ref": "#/$defs/nullableString"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "needs_owner"}}, "required": ["status"]},
          "then": {"properties": {"owner_request": {"$ref": "#/$defs/workerOwnerRequest"}}}
        },
        {
          "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
          "then": {
            "properties": {
              "commit": {"$ref": "#/$defs/nonEmptyString"},
              "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verificationEvidence"}}
            }
          }
        }
      ]
    },
    "verifierResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "assignment_id", "revision", "base_commit", "head_commit", "worker_result_digest", "profile", "thread_id", "turn_id", "status", "independent", "recursive", "summary", "findings", "verification", "observed_at"],
      "properties": {
        "schema_version": {"const": "codex-crew.verifier-result.v0.1"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1},
        "base_commit": {"$ref": "#/$defs/nonEmptyString"},
        "head_commit": {"$ref": "#/$defs/nonEmptyString"},
        "worker_result_digest": {"$ref": "#/$defs/nonEmptyString"},
        "profile": {"const": "verifier-sol-high"},
        "thread_id": {"$ref": "#/$defs/nonEmptyString"},
        "turn_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["passed", "failed", "blocked"]},
        "independent": {"const": true},
        "recursive": {"const": false},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "findings": {"type": "array", "items": {"type": "object"}},
        "verification": {"type": "array", "items": {"type": "object"}},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "verifierState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempts"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "running", "passed", "failed", "blocked"]},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/verifierResult"}}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "assignment_id", "revision", "worker_result_digest", "commit", "changed_paths", "verification", "verifier", "handoff", "disposition", "accepted_at"],
      "properties": {
        "schema_version": {"const": "codex-crew.acceptance.v0.1"},
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1},
        "worker_result_digest": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/nonEmptyString"},
        "changed_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verificationEvidence"}},
        "verifier": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/verifierResult"}]},
        "handoff": {"$ref": "#/$defs/serialHandoff"},
        "disposition": {"const": "accepted"},
        "accepted_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "serialHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "delivery_program_id", "worktree", "commit", "verification"],
      "properties": {
        "schema_version": {"const": "codex-crew.serial-handoff.v0"},
        "delivery_program_id": {"$ref": "#/$defs/identifier"},
        "worktree": {"$ref": "#/$defs/nonEmptyString"},
        "commit": {"$ref": "#/$defs/nonEmptyString"},
        "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verificationEvidence"}}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "assignment_id", "kind", "revision", "goal", "non_goals", "acceptance_criteria", "assurance_mode", "execution_profile", "execution_profile_selection", "access_mode", "allowed_paths", "external_resources", "verification_commands", "depends_on", "context", "status", "workspace", "boundary_evidence", "worker", "result", "verifier", "acceptance"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "kind": {"const": "delivery"},
        "revision": {"type": "integer", "minimum": 1},
        "goal": {"$ref": "#/$defs/nonEmptyString"},
        "non_goals": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "assurance_mode": {"enum": ["lite", "full"]},
        "execution_profile": {"$ref": "#/$defs/nonEmptyString"},
        "execution_profile_selection": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/executionProfileSelection"}]},
        "access_mode": {"enum": ["repository_read_only", "workspace_write"]},
        "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "external_resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "verification_commands": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fresh", "continuation_allowed"],
          "properties": {"fresh": {"type": "boolean"}, "continuation_allowed": {"type": "boolean"}}
        },
        "status": {"enum": ["planned", "ready", "running", "awaiting_orchestrator", "awaiting_owner", "submitted", "verifying", "accepted", "rejected", "failed", "cancelled"]},
        "workspace": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workspace"}]},
        "boundary_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_revision", "pre_git", "post_git"],
          "properties": {
            "source_revision": {"$ref": "#/$defs/nullableString"},
            "pre_git": {"$ref": "#/$defs/gitBoundary"},
            "post_git": {"$ref": "#/$defs/gitBoundary"}
          }
        },
        "worker": {"$ref": "#/$defs/workerBinding"},
        "result": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workerResult"}]},
        "verifier": {"$ref": "#/$defs/verifierState"},
        "acceptance": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/acceptance"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]},
          "then": {"properties": {"acceptance": {"$ref": "#/$defs/acceptance"}}}
        },
        {
          "if": {"properties": {"assurance_mode": {"const": "lite"}}, "required": ["assurance_mode"]},
          "then": {"properties": {"verifier": {"type": "object", "additionalProperties": false, "required": ["status", "attempts"], "properties": {"status": {"const": "not_required"}, "attempts": {"type": "array", "maxItems": 0}}}}}
        },
        {
          "if": {"properties": {"access_mode": {"const": "repository_read_only"}}, "required": ["access_mode"]},
          "then": {"properties": {"allowed_paths": {"type": "array", "maxItems": 0}, "workspace": {"type": "null"}}},
          "else": {"properties": {"allowed_paths": {"type": "array", "minItems": 1}, "workspace": {"$ref": "#/$defs/workspace"}}}
        }
      ]
    },
    "crewCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_active_workers", "roles", "assurance_modes", "worker_access_modes", "workspace_strategies", "runtime"],
      "properties": {
        "max_active_workers": {"const": 4},
        "roles": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["worker", "verifier"]}},
        "assurance_modes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["lite", "full"]}},
        "worker_access_modes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["repository_read_only", "workspace_write"]}},
        "workspace_strategies": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["new", "reuse"]}},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cohort_parallelism_available", "observed_at", "evidence"],
          "properties": {
            "cohort_parallelism_available": {"type": "boolean"},
            "observed_at": {"$ref": "#/$defs/nullableTimestamp"},
            "evidence": {"type": "string"}
          }
        }
      }
    },
    "crewIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "rationale", "updated_at"],
      "properties": {
        "shape": {"enum": ["orchestrator_read_only", "single_writer", "multi_writer"]},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "updated_at": {"$ref": "#/$defs/nullableTimestamp"}
      }
    },
    "writeLeaseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "path", "branch"],
      "properties": {
        "assignment_id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "crewObserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_worker_ids", "ready_assignment_ids", "awaiting_owner_assignment_ids", "verifier_assignment_ids", "active_write_leases", "actual_shape", "updated_at"],
      "properties": {
        "active_worker_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "ready_assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "awaiting_owner_assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "verifier_assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "active_write_leases": {"type": "array", "items": {"$ref": "#/$defs/writeLeaseObservation"}},
        "actual_shape": {"enum": ["orchestrator_read_only", "single_writer", "multi_writer"]},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "crew": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "intent", "observed"],
      "properties": {
        "capabilities": {"$ref": "#/$defs/crewCapabilities"},
        "intent": {"$ref": "#/$defs/crewIntent"},
        "observed": {"$ref": "#/$defs/crewObserved"}
      }
    },
    "ownerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "detail", "provenance", "decided_at"],
      "properties": {
        "disposition": {"enum": ["approved", "rejected"]},
        "detail": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {"$ref": "#/$defs/nonEmptyString"},
        "decided_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "ownerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "scope", "assignment_id", "category", "detail", "status", "requested_at", "resolved_at", "decision"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "scope": {"enum": ["assignment", "run"]},
        "assignment_id": {"type": ["string", "null"]},
        "category": {"enum": ["scope_change", "authority_expansion", "irreversible_external_side_effect", "acceptance_ambiguity"]},
        "detail": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["open", "resolved", "cancelled"]},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "resolved_at": {"$ref": "#/$defs/nullableTimestamp"},
        "decision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ownerDecision"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "assignment"}}, "required": ["scope"]},
          "then": {"properties": {"assignment_id": {"$ref": "#/$defs/identifier"}}},
          "else": {"properties": {"assignment_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
          "then": {"properties": {"resolved_at": {"$ref": "#/$defs/timestamp"}, "decision": {"$ref": "#/$defs/ownerDecision"}}}
        }
      ]
    },
    "messageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "detail"],
      "properties": {
        "disposition": {"enum": ["approved", "rejected"]},
        "detail": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "kind", "provenance", "body", "request_id", "decision", "at"],
      "properties": {
        "message_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["ordinary_correction", "owner_decision"]},
        "provenance": {"$ref": "#/$defs/nonEmptyString"},
        "body": {"$ref": "#/$defs/nonEmptyString"},
        "request_id": {"type": ["string", "null"]},
        "decision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/messageDecision"}]},
        "at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "owner_decision"}}, "required": ["kind"]},
          "then": {"properties": {"request_id": {"$ref": "#/$defs/identifier"}, "decision": {"$ref": "#/$defs/messageDecision"}}},
          "else": {"properties": {"request_id": {"type": "null"}, "decision": {"type": "null"}}}
        }
      ]
    },
    "brokerNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notification_id", "kind", "summary", "assignment_ids", "created_at"],
      "properties": {
        "notification_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["crew_intent_changed", "assignment_defined", "worker_started", "worker_result", "verifier_result", "owner_request", "workspace_changed", "material_plan_change", "terminal"]},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "at", "kind", "data"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "at": {"$ref": "#/$defs/timestamp"},
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "data": {"type": "object"}
      }
    },
    "runTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "summary", "fact_refs", "incomplete_facts", "finished_at"],
      "properties": {
        "disposition": {"enum": ["succeeded", "partial", "blocked", "needs_owner", "failed"]},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "fact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "incomplete_facts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "finished_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "detail", "at"],
      "properties": {
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "detail": {"$ref": "#/$defs/nonEmptyString"},
        "assignment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "workspaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "requestedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "model", "reasoning_effort", "sandbox", "approval_policy", "network_access"],
      "properties": {
        "profile": {"$ref": "#/$defs/nonEmptyString"},
        "model": {"$ref": "#/$defs/nullableString"},
        "reasoning_effort": {"$ref": "#/$defs/nullableString"},
        "sandbox": {"const": "read-only"},
        "approval_policy": {"const": "never"},
        "network_access": {"const": false}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "observed_at", "valid_envelope"],
      "properties": {
        "status": {"enum": ["not_started", "awaiting_terminal", "completed"]},
        "source": {"enum": ["none", "turn_start_notifications", "notification_collection", "thread_history"]},
        "observed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "valid_envelope": {"type": "boolean"}
      }
    },
    "turnTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "status", "observed_at", "source", "valid_envelope"],
      "properties": {
        "observed": {"type": "boolean"},
        "status": {"enum": ["not_observed", "completed", "failed", "interrupted", "cancelled"]},
        "observed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "source": {"enum": ["none", "turn_start_notifications", "notification_collection", "thread_history"]},
        "valid_envelope": {"type": "boolean"}
      }
    },
    "notificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_count", "methods"],
      "properties": {
        "observed_count": {"type": "integer", "minimum": 0},
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "count"],
            "properties": {"method": {"$ref": "#/$defs/nonEmptyString"}, "count": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "process_alive", "last_notification_at", "last_notification_method"],
      "properties": {
        "observed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "process_alive": {"type": ["boolean", "null"]},
        "last_notification_at": {"$ref": "#/$defs/nullableTimestamp"},
        "last_notification_method": {"$ref": "#/$defs/nullableString"}
      }
    },
    "turnObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "started_at", "phase", "completion", "terminal", "interrupt", "notification_summary", "observation"],
      "properties": {
        "turn_id": {"$ref": "#/$defs/nullableString"},
        "started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "phase": {"enum": ["not_started", "started", "collecting_completion", "terminal_observed"]},
        "completion": {"$ref": "#/$defs/completion"},
        "terminal": {"$ref": "#/$defs/turnTerminal"},
        "interrupt": {"$ref": "#/$defs/interrupt"},
        "notification_summary": {"$ref": "#/$defs/notificationSummary"},
        "observation": {"$ref": "#/$defs/observation"}
      }
    },
    "gitBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "availability", "head", "is_clean", "porcelain", "error"],
      "properties": {
        "observed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "availability": {"enum": ["observed", "unavailable"]},
        "head": {"$ref": "#/$defs/nullableString"},
        "is_clean": {"type": ["boolean", "null"]},
        "porcelain": {"$ref": "#/$defs/nullableString"},
        "error": {"$ref": "#/$defs/nullableString"}
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "sandbox", "approval_policy", "context_fresh", "requested_execution", "turn", "boundary_evidence"],
      "properties": {
        "thread_id": {"$ref": "#/$defs/nullableString"},
        "sandbox": {"const": "read-only"},
        "approval_policy": {"const": "never"},
        "context_fresh": {"const": true},
        "requested_execution": {"$ref": "#/$defs/requestedExecution"},
        "turn": {"$ref": "#/$defs/turnObservation"},
        "boundary_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_git", "post_git"],
          "properties": {"pre_git": {"$ref": "#/$defs/gitBoundary"}, "post_git": {"$ref": "#/$defs/gitBoundary"}}
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "request_id", "requested_at", "handled_at", "reason", "provenance"],
      "properties": {
        "phase": {"enum": ["none", "requested", "cancelling", "cancelled", "quarantined"]},
        "request_id": {"$ref": "#/$defs/nullableString"},
        "requested_at": {"$ref": "#/$defs/nullableTimestamp"},
        "handled_at": {"$ref": "#/$defs/nullableTimestamp"},
        "reason": {"$ref": "#/$defs/nullableString"},
        "provenance": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}

{
  "contractVersion": "3.2",
  "stateVocabulary": {
    "task": ["PENDING", "READY", "RUNNING", "BLOCKED", "FAILED", "NEEDS-REVALIDATION", "DONE", "WAIVED", "SUPERSEDED"],
    "legacyTaskRead": ["NEEDS_SEAM"],
    "ticket": ["UNRECORDED", "IN_PROGRESS", "BLOCKED", "NEEDS-REVALIDATION", "SATISFIED", "WAIVED", "SUPERSEDED"],
    "gateVerdict": ["pass", "fail", "blocked", "defer"],
    "terminalGateVerdict": ["pass", "fail", "defer"],
    "initialState": {"task": "PENDING", "ticket": "UNRECORDED"}
  },
  "documents": {
    "compositionPattern": "Composition[^\\n]*tickets=(true|false),\\s*dag=(true|false)",
    "attemptPattern": "(?m)(?:(?:\\*\\*)?执行尝试 ID（Attempt ID）(?:\\*\\*)?|(?:\\*\\*)?Attempt ID(?:\\*\\*)?)[：:](?:\\*\\*)?\\s*([^\\s]+)",
    "ticketIdPattern": "\\*\\*Ticket ID[：:]\\*\\*\\s*([^\\s]+)",
    "taskHeadingPattern": "(?m)^###\\s+(T\\d+)\\s*[:：]",
    "taskBlockPattern": "(?ms)^###\\s+{task_id}\\s*[:：].*?(?=^###\\s+T\\d+\\s*[:：]|^##\\s|\\Z)",
    "taskStatePattern": "(?m)^-\\s*状态[：:]\\s*([A-Z_-]+)",
    "taskTableRowPattern": "(?m)^\\|\\s*(T\\d+)\\s*\\|",
    "ticketStatePattern": "(?m)^-\\s*值[：:]\\s*\\[?([^]\\n]+)",
    "dagArtifactPatterns": ["dag.md", "*.patch-dag.md"],
    "ticketArtifactPatterns": ["tickets/*.md"],
    "revisionDeclarationPattern": "(?m)^\\s*\\*{0,2}(?:决策修订（Decision Revision）|Decision Revision|规格修订（Spec Revision）|Spec Revision|计划修订（Plan Revision）)\\*{0,2}\\s*[：:]\\*{0,2}\\s*(?:[DSP]\\d+|N/A)(?:\\s+.*)?$"
  },
  "projections": {
    "markers": {
      "revisionSet": "revision-set",
      "runtimeState": "runtime-state",
      "gateStatus": "gate-status"
    },
    "revisionSet": {
      "decision": "决策修订（Decision Revision）：{decision}",
      "spec": "决策修订（Decision Revision）：{decision}\n规格修订（Spec Revision）：{spec}",
      "plan": "决策修订（Decision Revision）：{decision}\n规格修订（Spec Revision）：{spec}\n计划修订（Plan Revision）：{plan}"
    },
    "runtimeTask": {
      "header": ["| 任务 | 状态 | 证据 |", "| --- | --- | --- |"],
      "row": "| {id} | {state} | {evidence} |"
    },
    "runtimeTicket": "- 值：{state}\n- 直接证据：{evidence}",
    "gateStatus": {
      "empty": "状态：尚无已定稿门禁记录",
      "finalized": "状态：{id} · {verdict}"
    }
  },
  "gate": {
    "headingPattern": "^##\\s+(?P<id>[^\\s]+)\\s+·\\s+(?P<verdict>{verdicts})[ \\t]*\\n",
    "entryIdPattern": "(.+)-G([1-9]\\d*)",
    "attemptFieldPattern": "(?m)^-\\s*(?:执行尝试 ID（Attempt ID）|Attempt ID)[：:]\\s*([^\\s]+)",
    "supersedesFieldPattern": "(?m)^-\\s*(?:取代（Supersedes）|Supersedes)[：:]\\s*([^\\s]+)",
    "revisionSetFieldPattern": "(?m)^-\\s*(?:修订集合（Revision set）|Revision set)[：:]\\s*(D\\d+|N/A)\\s*/\\s*(S\\d+|N/A)\\s*/\\s*(P\\d+|N/A)\\s*$",
    "noneTokens": ["none", "None", "无"],
    "scaffoldNoneToken": "none"
  }
}

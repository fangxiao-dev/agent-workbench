{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stable Docs Backfill Repository Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "targetBranch", "implementations", "stableDocs", "records"],
  "properties": {
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "targetBranch": {"type": "string", "minLength": 1},
    "implementations": {"$ref": "#/$defs/paths"},
    "stableDocs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemKnowledge", "moduleKnowledge"],
      "properties": {
        "systemKnowledge": {"$ref": "#/$defs/paths"},
        "contextKnowledge": {"$ref": "#/$defs/paths"},
        "moduleKnowledge": {"$ref": "#/$defs/paths"}
      }
    },
    "ignore": {
      "type": "array",
      "items": {"$ref": "#/$defs/ignoreEntry"}
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "done", "reports"],
      "properties": {
        "pending": {"$ref": "#/$defs/paths"},
        "done": {"$ref": "#/$defs/path"},
        "reports": {"$ref": "#/$defs/path"}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$)|[*?\\[])"}},
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true},
    "ignoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owner", "reason"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/stable-docs-backfill/repository-config.schema.json",
  "title": "Stable Docs Backfill repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "repository",
    "targetBranch",
    "implementations",
    "stableDocs",
    "records"
  ],
  "properties": {
    "contractVersion": {
      "const": "3.2"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!-)(?!.*\\s).+$"
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePathOrGlob"
      },
      "uniqueItems": true
    },
    "stableDocs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemKnowledge",
        "moduleKnowledge"
      ],
      "properties": {
        "systemKnowledge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePathOrGlob"
          },
          "uniqueItems": true
        },
        "contextKnowledge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePathOrGlob"
          },
          "uniqueItems": true
        },
        "moduleKnowledge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePathOrGlob"
          },
          "uniqueItems": true
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths",
          "owner",
          "reason"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/relativePathOrGlob"
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "done",
        "reports"
      ],
      "properties": {
        "pending": {
          "const": "auto"
        },
        "pendingOverrides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/relativePath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "done": {
          "$ref": "#/$defs/relativePath"
        },
        "reports": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "relativePathOrGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}

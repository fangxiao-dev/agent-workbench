{
  "schemaVersion": 1,
  "repository": "fujigawafood/fujigawafood-webapp",
  "canonicalDocs": [
    {
      "path": "CONTEXT.md",
      "role": "context-language",
      "owner": "product-domain-owner"
    },
    {
      "path": "docs/top-level-knowledge",
      "role": "top-level-knowledge",
      "owner": "product-architecture-owner"
    },
    {
      "path": "docs/module-knowledge",
      "role": "module-knowledge",
      "owner": "module-owners",
      "moduleInventory": true
    }
  ],
  "pendingPath": "docs/module-knowledge/_pending.md",
  "compactionPath": "docs/module-knowledge/_compaction",
  "statePath": "docs/module-knowledge/_compaction/state.json",
  "implementationsPath": "docs/implementations",
  "excludePaths": [
    "docs/implementations/fixtures"
  ],
  "dangerRules": [
    {
      "id": "retired-doc-roots",
      "description": "Retired func-design and module-specs roots must not remain in current canonical knowledge.",
      "literals": [
        "docs/func-design/",
        "docs/module-specs/"
      ],
      "paths": [
        "CONTEXT.md",
        "docs/top-level-knowledge",
        "docs/module-knowledge"
      ]
    },
    {
      "id": "retired-current-language",
      "description": "Retired behavior must not be presented as a current top-level contract.",
      "literals": [
        "historical read-only",
        "历史只读"
      ],
      "paths": [
        "CONTEXT.md",
        "docs/top-level-knowledge"
      ]
    },
    {
      "id": "retired-kaispan-context-field",
      "description": "The removed KaiSpan previousContextPath field must not return to current knowledge.",
      "literals": [
        "previousContextPath"
      ],
      "paths": [
        "docs/top-level-knowledge",
        "docs/module-knowledge"
      ]
    }
  ]
}
